{
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/scrape?slot=morning",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/cron/scrape?slot=morning",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/cron/scrape?slot=evening",
      "schedule": "15 21 * * *"
    },
    {
      "path": "/api/cron/scrape?slot=evening",
      "schedule": "15 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/blog",
      "destination": "/api/page?view=blog"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/page?view=rss&feed=blog"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/page?view=rss&feed=news"
    },
    {
      "source": "/blog/:slug/cover.png",
      "destination": "/api/page?view=image&slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?view=post&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?view=sitemap"
    },
    {
      "source": "/admin",
      "destination": "/api/page?view=admin"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/scrape.js": {
      "maxDuration": 60
    },
    "api/page.js": {
      "includeFiles": "templates/**"
    }
  }
}
